{
  "authority": 0,
  "autostart": true,
  "binary": {
    "linux": {
      "aarch64": "target/release/language_constrainer_rs",
      "arm": "target/release/language_constrainer_rs",
      "x86_64": "target/release/language_constrainer_rs"
    },
    "macos": {
      "aarch64": "target/release/language_constrainer_rs",
      "arm": "target/release/language_constrainer_rs",
      "x86_64": "target/release/language_constrainer_rs"
    },
    "windows": {
      "aarch64": "target/release/language_constrainer_rs.exe",
      "arm": "target/release/language_constrainer_rs.exe",
      "x86_64": "target/release/language_constrainer_rs.exe"
    }
  },
  "build_command": "cargo",
  "build_flags": [
    "build",
    "--release"
  ],
  "capabilities": "inprocess",
  "command_flags": [
    "run",
    "--release"
  ],
  "credentials": [
    {
      "key": "language",
      "label": "Target Language",
      "list": false,
      "sensitive": false
    },
    {
      "key": "allow_emoji",
      "label": "Allow emoji",
      "list": false,
      "sensitive": false
    },
    {
      "key": "allow_expressive",
      "label": "Allow expressive characters",
      "list": false,
      "sensitive": false
    },
    {
      "key": "flag_reason",
      "label": "Flag reason",
      "list": false,
      "sensitive": false
    }
  ],
  "description": "constrains chat to a target language; out-of-language messages are held for audit (a moderator must approve/reject them)",
  "launch_command": "cargo",
  "min_rank": 0,
  "name": "language-constrainer",
  "price": 0,
  "root_file": "./src/main.rs",
  "version": "0.1.0"
}